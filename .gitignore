# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- local backup / broken files ---
*.bak
*.bad*
*.broken*
package-lock 2.json
tsconfig.json.bad*
package.json.bad*
package.json.broken*

.gitignore.bak.*
.ops.env
.next-dev/
step3-deploy-dir/

# Nested scaffold — never deploy this
sushizen-shift-pwa/

# Claude Code local settings (may contain secrets/tokens)
.claude/settings.local.json

# Price monitor session files (contain auth tokens — upload to GitHub Secrets instead)
scripts/*/keeta-session.*
# Keeta needs one session per brand account, so the files are suffixed
# (keeta-session-ramen_zen.json) and the pattern above no longer catches them.
scripts/*/keeta-session-*
scripts/*/careem-session.*
scripts/*/noon-session.*
scripts/grab/*-session.*
scripts/grab/*-session.*
scripts/grab/*-api-discovery.json

# Talabat session files (contain auth credentials — never commit)
scripts/talabat/talabat-session*.json
scripts/talabat/talabat-session*.b64.txt
scripts/talabat/talabat-session*.txt
scripts/talabat/talabat-api-discovery.json

# FoodPanda session files (contain auth tokens — never commit)
scripts/foodpanda/*-session.json
scripts/foodpanda/*-session.b64.txt
scripts/foodpanda/*-api-discovery.json

# Worktree-local Claude instructions (Session 2 rules etc.) — never shared with main
CLAUDE.local.md

# Finder-style duplicates ("main 2.py", "routes.d 2.ts") — never intentional,
# and a committed one poisons grep. `git add -f` if you ever want one.
* [0-9].*
